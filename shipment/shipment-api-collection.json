{
  "info": {
    "_postman_id": "5a7e6a47-f4c0-41e6-8f40-3c46bce74031",
    "name": "Fastlivery Express - Shipment Service",
    "description": "Fastlivery API collection. Register a customer or log in to obtain a JWT; the collection stores the returned access token for authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Demo\",\n  \"lastname\": \"Customer\",\n  \"email\": \"demo.customer@example.com\",\n  \"mobileNumber\": \"01012345678\",\n  \"password\": \"DemoPassword123!\",\n  \"preferredLanguage\": \"en\",\n  \"deliveryAddress\": \"Nasr City, Cairo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a Customer profile and returns a JWT. The profile ID is saved to the customerId collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.accessToken) pm.collectionVariables.set(\"accessToken\", body.data.accessToken);",
                  "  if (body.data && body.data.customer && body.data.customer.userId) pm.collectionVariables.set(\"customerId\", body.data.customer.userId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.customer@example.com\",\n  \"password\": \"DemoPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Returns a JWT for the registered account and saves it as the collection accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.accessToken) pm.collectionVariables.set(\"accessToken\", body.data.accessToken);",
                  "  if (body.data && body.data.customer && body.data.customer.userId) pm.collectionVariables.set(\"customerId\", body.data.customer.userId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Order Flow",
      "item": [
        {
          "name": "Request Shipment Quote and Assign Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.shipment && json.data.shipment.id) {",
                  "    pm.collectionVariables.set('shipmentId', json.data.shipment.id);",
                  "  }",
                  "  if (json.data && json.data.shipment && json.data.shipment.trackingNumber) {",
                  "    pm.collectionVariables.set('trackingNumber', json.data.shipment.trackingNumber);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originAddress\": \"Nasr City, Cairo\",\n  \"destinationAddress\": \"Maadi, Cairo\",\n  \"originLatitude\": {{originLatitude}},\n  \"originLongitude\": {{originLongitude}},\n  \"destinationLatitude\": {{destinationLatitude}},\n  \"destinationLongitude\": {{destinationLongitude}},\n  \"totalWeight\": 2.5,\n  \"packageDetails\": \"Small fragile package\",\n  \"packageDimensions\": \"30x20x15 cm\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipments",
                "request"
              ]
            },
            "description": "Calculates price through pricing service, finds nearest available driver through user service, and creates a PENDING_CONFIRMATION shipment."
          },
          "response": []
        },
        {
          "name": "Confirm Shipment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipments",
                "{{shipmentId}}",
                "confirm"
              ]
            },
            "description": "Confirms a PENDING_CONFIRMATION shipment and marks the assigned driver unavailable."
          },
          "response": []
        },
        {
          "name": "Create Stripe Checkout Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.checkoutSessionId) {",
                  "    pm.collectionVariables.set('stripeCheckoutSessionId', json.data.checkoutSessionId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}/payment/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipments",
                "{{shipmentId}}",
                "payment",
                "checkout"
              ]
            },
            "description": "Creates a Stripe Checkout Session and returns the hosted checkout URL."
          },
          "response": []
        },
        {
          "name": "Sync Stripe Checkout Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments/payment/sync?session_id={{stripeCheckoutSessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipments",
                "payment",
                "sync"
              ],
              "query": [
                {
                  "key": "session_id",
                  "value": "{{stripeCheckoutSessionId}}"
                }
              ]
            },
            "description": "Retrieves a Stripe Checkout Session and updates shipment paymentStatus."
          },
          "response": []
        },
        {
          "name": "Track Shipment by Tracking Number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments/track/{{trackingNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipments",
                "track",
                "{{trackingNumber}}"
              ]
            },
            "description": "Returns shipment status, ETA, last known location, and assigned driver's latest location."
          },
          "response": []
        }
      ]
    },
